grafana:
  enabled: true
  adminUser: admin
  adminPassword: admin

  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000


prometheus:
  service:
    type: NodePort
    port: 80
    targetPort: 9090
    nodePort: 32090

  prometheusSpec:
    retention: 10d

    resources:
      requests:
        memory: 512Mi
      limits:
        memory: 1Gi


prometheus-node-exporter:
  enabled: true
  tolerations:
    - operator: Exists   # allows running on ALL nodes


kube-state-metrics:
  enabled: true


alertmanager:
  enabled: false
