global:
  resolve_timeout: 5m

  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "alerts@gmail.com"
  smtp_auth_username: "alerts@gmail.com"
  smtp_auth_password: "{{ alertmanager_smtp_password }}"
