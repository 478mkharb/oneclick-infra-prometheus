{
  "uid": "prometheus-overview",
  "title": "Prometheus Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "style": "dark",
  "editable": true,
  "tags": ["prometheus", "monitoring"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Prometheus Reload",
        "type": "alert",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "expr": "changes(prometheus_config_last_reload_successful[5m]) > 0",
        "iconColor": "green",
        "enable": true
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": "label_values(up, job)",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "sum(up{job=~\"$job\", instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets Down",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "count(up{job=~\"$job\", instance=~\"$instance\"} == 0)",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape Duration (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "scrape_duration_seconds{job=~\"$job\", instance=~\"$instance\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 6 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Samples Ingested / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 6 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TSDB Head Series",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "prometheus_tsdb_head_series",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "TSDB Head Chunks",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "prometheus_tsdb_head_chunks",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rule Evaluation Duration (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "rate(prometheus_evaluator_duration_seconds_sum[5m]) * 1000",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 }
    }
  ]
}