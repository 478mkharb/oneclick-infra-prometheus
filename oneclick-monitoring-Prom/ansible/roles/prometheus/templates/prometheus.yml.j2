global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: {{ prometheus_environment }}

scrape_configs:

  # Prometheus self (FIXED)
  - job_name: prometheus
    metrics_path: /prometheus/metrics
    static_configs:
      - targets:
          - localhost:9090

  # Node Exporter (EC2)
  - job_name: node-exporter
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: instance-state-name
            values: ["running"]
          - name: tag:Role
            values: ["monitoring"]

    relabel_configs:
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:9100"
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance

  # Nginx metrics
  - job_name: nginx
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: instance-state-name
            values: ["running"]
          - name: tag:Role
            values: ["monitoring"]

    relabel_configs:
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:9113"
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance

  # Blackbox probe (ALB)
  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://monitoring-alb-xxxx.ap-south-1.elb.amazonaws.com/
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: instance
        replacement: alb
      - target_label: __address__
        replacement: 127.0.0.1:9115
