global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: {{ prometheus_environment }}

scrape_configs:

  # -------------------------------------------------
  # Prometheus self
  # -------------------------------------------------
  - job_name: prometheus
    metrics_path: /prometheus/metrics
    static_configs:
      - targets:
          - localhost:9090

  # -------------------------------------------------
  # Node Exporter (ASG-safe)
  # -------------------------------------------------
  - job_name: node-exporter
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: instance-state-name
            values: ["running"]
          - name: tag:Role
            values: ["monitoring"]

    relabel_configs:
      # target address
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:9100"

      # UNIQUE identity (fixes duplicates)
      - source_labels: [__meta_ec2_instance_id]
        target_label: instance_id

      # Human-readable name
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance_name

      # optional: AZ visibility
      - source_labels: [__meta_ec2_availability_zone]
        target_label: az

  # -------------------------------------------------
  # Nginx Exporter (ASG-safe)
  # -------------------------------------------------
  - job_name: nginx
    ec2_sd_configs:
      - region: {{ aws_region }}
        filters:
          - name: instance-state-name
            values: ["running"]
          - name: tag:Role
            values: ["monitoring"]

    relabel_configs:
      # target address
      - source_labels: [__meta_ec2_private_ip]
        target_label: __address__
        replacement: "$1:9113"

      # UNIQUE identity (fixes duplicates)
      - source_labels: [__meta_ec2_instance_id]
        target_label: instance_id

      # Human-readable name
      - source_labels: [__meta_ec2_tag_Name]
        target_label: instance_name

      # optional: AZ visibility
      - source_labels: [__meta_ec2_availability_zone]
        target_label: az
