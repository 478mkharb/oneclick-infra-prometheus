pipeline {
  agent any

  parameters {
    choice(
      name: 'TF_ACTION',
      choices: ['apply', 'destroy'],
      description: 'Terraform action to perform'
    )
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'git@github.com:478mkharb/oneclick-infra-prometheus.git'
      }
    }

    stage('Preflight: Docker Check') {
      steps {
        sh '''
          echo "Checking Docker availability..."
          docker --version
        '''
      }
    }

    stage('GitLeaks Scan (CI)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/repo" \
            zricethezav/gitleaks:latest \
            detect --source=/repo --no-git
        '''
      }
    }

    stage('Terraform FMT & Validate (CI)') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform fmt -check -recursive
            terraform init -backend=false
            terraform validate
          '''
        }
      }
    }

    stage('Terraform Security Scan (tfsec)') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        sh '''
          docker run --rm \
            -v "$PWD/oneclick-monitoring-Prom/terraform:/src" \
            aquasec/tfsec /src
        '''
      }
    }

    stage('Terraform Lint (tflint)') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            docker run --rm \
              -v "$PWD:/data" \
              -w /data \
              ghcr.io/terraform-linters/tflint
          '''
        }
      }
    }

    stage('Terraform Apply / Destroy') {
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform init

            if [ "${TF_ACTION}" = "apply" ]; then
              terraform apply -auto-approve
            else
              terraform destroy -auto-approve
            fi
          '''
        }
      }
    }

    stage('Wait for SSM') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        sh 'sleep 30'
      }
    }

    stage('Ansible Lint (CI)') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/ansible') {
          sh '''
            docker run --rm \
              -v "$PWD:/work" \
              -w /work \
              cytopia/ansible-lint .
          '''
        }
      }
    }

    stage('Run Ansible (SSM)') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/ansible') {
          sh '''
            export PATH=$PATH:/var/lib/jenkins/.local/bin
            export ANSIBLE_CONFIG=$WORKSPACE/oneclick-monitoring-Prom/ansible/ansible.cfg
            ansible-galaxy collection install amazon.aws --force
            ansible-playbook -i inventory/aws_ec2.yml site.yml -vvv
          '''
        }
      }
    }
  }

  post {
    success {
      echo "✅ Pipeline completed successfully"
    }
    failure {
      echo "❌ Pipeline failed – check Docker / CI tool output"
    }
  }
}
