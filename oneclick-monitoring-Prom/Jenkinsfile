pipeline {
  agent any

  options {
    withBuildUser()
    timestamps()
  }

  parameters {
    choice(
      name: 'RUN_MODE',
      choices: ['FULL', 'CONFIG_ONLY'],
      description: 'FULL = Terraform + Ansible | CONFIG_ONLY = Ansible only'
    )

    choice(
      name: 'TF_ACTION',
      choices: ['apply', 'destroy'],
      description: 'Terraform action'
    )

    booleanParam(
      name: 'DRY_RUN',
      defaultValue: true,
      description: 'Dry run only (Terraform plan, no apply)'
    )

    booleanParam(
      name: 'SEND_PLAN_IN_MAIL',
      defaultValue: true,
      description: 'Attach Terraform plan output in email'
    )
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
    ALERTMANAGER_SMTP_PASSWORD = credentials('ALERTMANAGER_SMTP_PASSWORD')
  }

  stages {

    /* ================= CHECKOUT ================= */

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'git@github.com:478mkharb/oneclick-infra-prometheus.git'
      }
    }

    stage('Prepare Reports Directory') {
      steps {
        sh 'mkdir -p reports/gitleaks reports/tflint reports/ansible-lint'
      }
    }

    stage('Preflight') {
      steps {
        sh 'docker --version'
      }
    }

    stage('Info') {
      steps {
        echo "RUN_MODE=${params.RUN_MODE}"
        echo "TF_ACTION=${params.TF_ACTION}"
        echo "DRY_RUN=${params.DRY_RUN}"
      }
    }

    /* ================= SECURITY ================= */

    stage('Gitleaks Scan') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/repo" \
            zricethezav/gitleaks:latest \
            detect \
            --source=/repo \
            --no-git \
            --report-format json \
            --report-path /repo/reports/gitleaks/gitleaks-report.json \
            || true
        '''
      }
    }

    /* ================= TERRAFORM ================= */

    stage('Terraform Validate') {
      when {
        expression { params.RUN_MODE == 'FULL' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform fmt -recursive
            terraform init -backend=false
            terraform validate
          '''
        }
      }
    }

    stage('Terraform Lint') {
      when {
        expression { params.RUN_MODE == 'FULL' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            docker run --rm \
              -v "$PWD:/data" \
              -w /data \
              ghcr.io/terraform-linters/tflint \
              --format json \
              > ../../reports/tflint/tflint-report.json || true
          '''
        }
      }
    }

    /* ================= TERRAFORM PLAN (DRY RUN) ================= */

    stage('Terraform Plan (Dry Run)') {
      when {
        expression { params.RUN_MODE == 'FULL' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform init

            terraform plan \
              -out=tfplan \
              -no-color

            terraform show -no-color tfplan \
              > ../../reports/tfplan.txt
          '''
        }
      }
    }

    /* ================= APPLY / DESTROY ================= */

    stage('Terraform Apply / Destroy') {
      when {
        expression {
          params.RUN_MODE == 'FULL' &&
          params.DRY_RUN == false
        }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            if [ "${TF_ACTION}" = "apply" ]; then
              terraform apply -auto-approve tfplan
            else
              terraform destroy -auto-approve
            fi
          '''
        }
      }
    }

    stage('Fetch Terraform Outputs') {
      when {
        expression {
          params.RUN_MODE == 'FULL' &&
          params.TF_ACTION == 'apply' &&
          params.DRY_RUN == false
        }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          script {
            env.ALB_DNS = sh(
              script: 'terraform output -raw alb_dns',
              returnStdout: true
            ).trim()
          }
        }
      }
    }

    /* ================= ANSIBLE ================= */

    stage('Ansible Lint') {
      when {
        expression {
          params.TF_ACTION == 'apply' &&
          params.DRY_RUN == false
        }
      }
      steps {
        dir('oneclick-monitoring-Prom/ansible') {
          sh '''
            docker run --rm \
              -v "$PWD:/work" \
              -w /work \
              cytopia/ansible-lint \
              -f json \
              . > ../../reports/ansible-lint/ansible-lint-report.json || true
          '''
        }
      }
    }

    stage('Ansible Run') {
      when {
        expression {
          params.TF_ACTION == 'apply' &&
          params.DRY_RUN == false
        }
      }
      steps {
        ansiColor('xterm') {
          dir('oneclick-monitoring-Prom/ansible') {
            sh """
              export ANSIBLE_CONFIG=\$WORKSPACE/oneclick-monitoring-Prom/ansible/ansible.cfg
              export ANSIBLE_FORCE_COLOR=true
              ansible-galaxy collection install amazon.aws --force
              ansible-playbook \
                -i inventory/aws_ec2.aws_ec2.yml \
                site.yml \
                -e "alertmanager_smtp_password=${ALERTMANAGER_SMTP_PASSWORD}" \
                ${params.RUN_MODE == 'FULL' ? "-e alb_dns=${env.ALB_DNS}" : ""}
            """
          }
        }
      }
    }

    /* ================= EMAIL VARIABLES ================= */

    stage('Prepare Email Variables') {
      steps {
        script {
          env.MAIL_BUILD_DURATION = currentBuild.durationString
          env.MAIL_NODE_NAME = env.NODE_NAME
          env.MAIL_WORKSPACE = env.WORKSPACE
          env.MAIL_AWS_REGION = env.AWS_DEFAULT_REGION
        }
      }
    }
  }

  /* ================= POST ACTIONS ================= */

  post {
    success {
      emailext(
        to: '478mkharb@gmail.com',
        subject: '$PROJECT_NAME | SUCCESS | Build #$BUILD_NUMBER',
        body: '$DEFAULT_CONTENT',
        mimeType: 'text/html',
        attachLog: true,
        attachmentsPattern: params.SEND_PLAN_IN_MAIL ? 'reports/tfplan.txt' : ''
      )
    }

    failure {
      emailext(
        to: '478mkharb@gmail.com',
        subject: '$PROJECT_NAME | FAILED | Build #$BUILD_NUMBER',
        body: '$DEFAULT_CONTENT',
        mimeType: 'text/html',
        attachLog: true,
        attachmentsPattern: 'reports/tfplan.txt'
      )
    }
  }
}