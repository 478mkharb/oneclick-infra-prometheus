pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  options {
    timestamps()
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('GitLeaks Scan (CI)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/work" \
            -w /work \
            zricethezav/gitleaks:latest \
            detect --source . --no-git --verbose
        '''
      }
    }

    stage('Terraform FMT & Validate (CI)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD/oneclick-monitoring-Prom/terraform:/work" \
            -w /work \
            hashicorp/terraform:1.6 \
            sh -c "
              terraform version &&
              terraform fmt -recursive -check &&
              terraform init -backend=false &&
              terraform validate
            "
        '''
      }
    }

    stage('Terraform Security Scan (tfsec)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/work" \
            -w /work \
            aquasec/tfsec:latest \
            .
        '''
      }
    }

    stage('Terraform Lint (tflint)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/work" \
            -w /work \
            ghcr.io/terraform-linters/tflint:latest \
            sh -c "
              tflint --init &&
              tflint
            "
        '''
      }
    }

    stage('Ansible Lint (CI)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/work" \
            -w /work \
            cytopia/ansible-lint:latest \
            .
        '''
      }
    }

  }

  post {
    success {
      echo '✅ Pipeline completed successfully'
    }
    failure {
      echo '❌ Pipeline failed – check logs above'
    }
  }
}
