pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  options {
    timestamps()
    ansiColor('xterm')
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('GitLeaks Scan (CI)') {
      agent {
        docker {
          image 'zricethezav/gitleaks:latest'
        }
      }
      steps {
        sh '''
          gitleaks detect \
            --source . \
            --no-git \
            --verbose
        '''
      }
    }

    stage('Terraform FMT & Validate (CI)') {
      agent {
        docker {
          image 'hashicorp/terraform:1.6'
        }
      }
      steps {
        sh '''
          terraform version
          terraform fmt -recursive -check
          terraform init -backend=false
          terraform validate
        '''
      }
    }

    stage('Terraform Security Scan (tfsec)') {
      agent {
        docker {
          image 'aquasec/tfsec:latest'
        }
      }
      steps {
        sh '''
          tfsec .
        '''
      }
    }

    stage('Terraform Lint (tflint)') {
      agent {
        docker {
          image 'ghcr.io/terraform-linters/tflint:latest'
        }
      }
      steps {
        sh '''
          tflint --init
          tflint
        '''
      }
    }

    stage('Ansible Lint (CI)') {
      agent {
        docker {
          image 'cytopia/ansible-lint:latest'
        }
      }
      steps {
        sh '''
          ansible-lint .
        '''
      }
    }

  }

  post {
    success {
      echo '✅ Pipeline completed successfully'
    }
    failure {
      echo '❌ Pipeline failed – check logs above'
    }
  }
}
