pipeline {
  agent any

  parameters {
    choice(
      name: 'RUN_MODE',
      choices: ['FULL', 'CONFIG_ONLY'],
      description: 'FULL = Terraform + Ansible | CONFIG_ONLY = Ansible only'
    )

    choice(
      name: 'TF_ACTION',
      choices: ['apply', 'destroy'],
      description: 'Terraform action (used only in FULL mode)'
    )
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'git@github.com:478mkharb/oneclick-infra-prometheus.git'
      }
    }

    stage('Preflight: Docker Check') {
      steps {
        sh 'docker --version'
      }
    }

    stage('Run Info') {
      steps {
        echo "RUN_MODE=${params.RUN_MODE}, TF_ACTION=${params.TF_ACTION}"
      }
    }

    stage('GitLeaks Scan (CI)') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/repo" \
            zricethezav/gitleaks:latest \
            detect --source=/repo --no-git
        '''
      }
    }

    stage('Terraform FMT & Validate') {
      when {
        allOf {
          expression { params.RUN_MODE == 'FULL' }
          expression { params.TF_ACTION == 'apply' }
        }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform fmt -recursive
            terraform init -backend=false
            terraform validate
          '''
        }
      }
    }

    stage('Terraform Lint (tflint)') {
      when {
        allOf {
          expression { params.RUN_MODE == 'FULL' }
          expression { params.TF_ACTION == 'apply' }
        }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            docker run --rm \
              -v "$PWD:/data" \
              -w /data \
              ghcr.io/terraform-linters/tflint
          '''
        }
      }
    }

    stage('Terraform Apply / Destroy') {
      when {
        expression { params.RUN_MODE == 'FULL' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform init

            if [ "${TF_ACTION}" = "apply" ]; then
              terraform apply -auto-approve
            else
              terraform destroy -auto-approve
            fi
          '''
        }
      }
    }

    stage('Fetch ALB DNS') {
      when {
        allOf {
          expression { params.RUN_MODE == 'FULL' }
          expression { params.TF_ACTION == 'apply' }
        }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          script {
            env.ALB_DNS = sh(
              script: 'terraform output -raw alb_dns',
              returnStdout: true
            ).trim()
          }
        }
        echo "ALB DNS = ${env.ALB_DNS}"
      }
    }

    stage('Ansible Lint (CI)') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/ansible') {
          sh '''
            docker run --rm \
              -v "$PWD:/work" \
              -w /work \
              cytopia/ansible-lint .
          '''
        }
      }
    }

    stage('Run Ansible') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        ansiColor('xterm') {
          dir('oneclick-monitoring-Prom/ansible') {
            sh """
              export PATH=\$PATH:/var/lib/jenkins/.local/bin
              export ANSIBLE_CONFIG=\$WORKSPACE/oneclick-monitoring-Prom/ansible/ansible.cfg
              export ANSIBLE_FORCE_COLOR=true
              ansible-galaxy collection install amazon.aws --force
              ansible-playbook -i inventory/aws_ec2.aws_ec2.yml site.yml -vvv
                ${params.RUN_MODE == 'FULL' ? "-e alb_dns=${env.ALB_DNS}" : ""}
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ Pipeline completed successfully"
    }
    failure {
      echo "❌ Pipeline failed – check logs"
    }
  }
}
