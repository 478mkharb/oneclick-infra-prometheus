pipeline {
  agent any

  options {
    withBuildUser() 
  }

  parameters {
    choice(
      name: 'RUN_MODE',
      choices: ['FULL', 'CONFIG_ONLY'],
      description: 'FULL = Terraform + Ansible | CONFIG_ONLY = Ansible only'
    )
    choice(
      name: 'TF_ACTION',
      choices: ['apply', 'destroy'],
      description: 'Terraform action'
    )
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-south-1'
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'mukesh',
            url: 'git@github.com:478mkharb/oneclick-infra-prometheus.git'
      }
    }

    stage('Preflight') {
      steps {
        sh 'docker --version'
      }
    }

    stage('Info') {
      steps {
        echo "RUN_MODE=${params.RUN_MODE} TF_ACTION=${params.TF_ACTION}"
      }
    }

    stage('Gitleaks') {
      steps {
        sh '''
          docker run --rm \
            -v "$PWD:/repo" \
            zricethezav/gitleaks:latest \
            detect --source=/repo --no-git
        '''
      }
    }

    stage('Terraform Validate') {
      when {
        expression { params.RUN_MODE == 'FULL' && params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform fmt -recursive
            terraform init -backend=false
            terraform validate
          '''
        }
      }
    }

    stage('Terraform Lint') {
      when {
        expression { params.RUN_MODE == 'FULL' && params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            docker run --rm \
              -v "$PWD:/data" \
              -w /data \
              ghcr.io/terraform-linters/tflint
          '''
        }
      }
    }

    stage('Terraform Apply') {
      when {
        expression { params.RUN_MODE == 'FULL' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            terraform init
            if [ "${TF_ACTION}" = "apply" ]; then
              terraform apply -auto-approve
            else
              terraform destroy -auto-approve
            fi
          '''
        }
      }
    }

    stage('Fetch Outputs') {
      when {
        expression { params.RUN_MODE == 'FULL' && params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          script {
            env.ALB_DNS = sh(
              script: 'terraform output -raw alb_dns',
              returnStdout: true
            ).trim()
          }
        }
      }
    }

    stage('Wait for ASG (SSM)') {
      when {
        expression { params.RUN_MODE == 'FULL' && params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/terraform') {
          sh '''
            ASG_NAME=$(terraform output -raw monitoring_asg_name)

            INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
              --auto-scaling-group-names "$ASG_NAME" \
              --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
              --output text \
              --region ${AWS_DEFAULT_REGION})

            while true; do
              ONLINE=$(aws ssm describe-instance-information \
                --query "InstanceInformationList[?PingStatus=='Online'].InstanceId" \
                --output text \
                --region ${AWS_DEFAULT_REGION})
              for ID in $INSTANCE_IDS; do echo "$ONLINE" | grep -q "$ID" || continue 2; done
              break
            done
          '''
        }
      }
    }

    stage('Ansible Lint') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        dir('oneclick-monitoring-Prom/ansible') {
          sh '''
            docker run --rm \
              -v "$PWD:/work" \
              -w /work \
              cytopia/ansible-lint .
          '''
        }
      }
    }

    stage('Ansible Run') {
      when {
        expression { params.TF_ACTION == 'apply' }
      }
      steps {
        ansiColor('xterm') {
          dir('oneclick-monitoring-Prom/ansible') {
            sh """
              export ANSIBLE_CONFIG=\$WORKSPACE/oneclick-monitoring-Prom/ansible/ansible.cfg
              export ANSIBLE_FORCE_COLOR=true
              ansible-galaxy collection install amazon.aws --force
              ansible-playbook \
                -i inventory/aws_ec2.aws_ec2.yml \
                site.yml \
                ${params.RUN_MODE == 'FULL' ? "-e alb_dns=${env.ALB_DNS}" : ""}
            """
          }
        }
      }
    }
  }

  post {

    success {
      emailext(
        to: "478mkharb@gmail.com",
        subject: "✅ Jenkins SUCCESS | ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        body: """
Hello Team,

✅ Jenkins Pipeline Execution SUCCESSFUL

--------------------------------------------------
Pipeline Status : SUCCESS
Job Name        : ${env.JOB_NAME}
Build Number    : #${env.BUILD_NUMBER}
Triggered By    : ${env.BUILD_USER ?: env.BUILD_CAUSE}
Run Mode        : ${params.RUN_MODE}
Terraform Action: ${params.TF_ACTION}
--------------------------------------------------

🔗 Build Details
${env.BUILD_URL}

Regards,
Jenkins CI/CD
""",
        mimeType: 'text/plain'
      )
    }

    failure {
      emailext(
        to: "478mkharb@gmail.com",
        subject: "🚨 Jenkins FAILED | ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        body: """
Hello Team,

🚨 Jenkins Pipeline Execution FAILED

--------------------------------------------------
Pipeline Status : FAILED
Job Name        : ${env.JOB_NAME}
Build Number    : #${env.BUILD_NUMBER}
Triggered By    : ${env.BUILD_USER ?: env.BUILD_CAUSE}
Run Mode        : ${params.RUN_MODE}
Terraform Action: ${params.TF_ACTION}
--------------------------------------------------

🔗 Console Logs
${env.BUILD_URL}

Regards,
Jenkins CI/CD
""",
        mimeType: 'text/plain',
        attachLog: true
      )
    }
  }
}