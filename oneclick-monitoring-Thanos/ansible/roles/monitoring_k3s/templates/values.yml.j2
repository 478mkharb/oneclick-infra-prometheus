# -----------------------------
# Grafana (secondary UI)
# -----------------------------
grafana:
  enabled: true

  adminUser: admin
  adminPassword: admin

  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000


# -----------------------------
# Prometheus (PRIMARY TOOL)
# -----------------------------
prometheus:
  enabled: true

  service:
    type: ClusterIP

  prometheusSpec:
    replicas: 2
    retention: 10d

    resources:
      requests:
        memory: 512Mi
      limits:
        memory: 1Gi

    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi

    # Thanos Sidecar (REQUIRED)
    thanos:
      enabled: true
      objectStorageConfig:
        existingSecret:
          name: thanos-objstore
          key: objstore.yml


# -----------------------------
# Node Exporter
# -----------------------------
prometheus-node-exporter:
  enabled: true
  tolerations:
    - operator: Exists


# -----------------------------
# kube-state-metrics
# -----------------------------
kube-state-metrics:
  enabled: true


# -----------------------------
# Alertmanager (disabled)
# -----------------------------
alertmanager:
  enabled: false
