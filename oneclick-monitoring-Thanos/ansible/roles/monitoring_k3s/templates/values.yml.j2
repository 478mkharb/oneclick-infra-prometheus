# -----------------------------
# Grafana (secondary UI)
# -----------------------------
grafana:
  enabled: true

  adminUser: admin
  adminPassword: admin

  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000

  defaultDashboardsEnabled: true

  sidecar:
    datasources:
      enabled: true
      defaultDatasourceEnabled: false

  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: Thanos
          type: prometheus
          url: http://thanos-query-query-frontend.monitoring.svc.cluster.local:9090
          access: proxy
          isDefault: true


# -----------------------------
# Prometheus (PRIMARY TOOL)
# -----------------------------
prometheus:
  enabled: true

  service:
    type: ClusterIP

  # REQUIRED for Thanos discovery
  thanosService:
    enabled: true

  prometheusSpec:
    replicas: 2
    retention: 10d

    resources:
      requests:
        memory: 512Mi
      limits:
        memory: 1Gi

    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi

    # Thanos sidecar
    thanos:
      objectStorageConfig:
        existingSecret:
          name: thanos-objstore
          key: objstore.yml


# -----------------------------
# Node Exporter
# -----------------------------
prometheus-node-exporter:
  enabled: true
  tolerations:
    - operator: Exists


# -----------------------------
# kube-state-metrics
# -----------------------------
kube-state-metrics:
  enabled: true


# -----------------------------
# Alertmanager (disabled)
# -----------------------------
alertmanager:
  enabled: false
