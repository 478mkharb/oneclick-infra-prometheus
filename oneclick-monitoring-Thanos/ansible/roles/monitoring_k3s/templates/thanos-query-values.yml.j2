image:
  registry: docker.io
  repository: bitnami/thanos
  tag: 0.40.1-debian-12-r0

query:
  enabled: true
  replicaCount: 1

  dnsDiscovery:
    enabled: true
    sidecarsService: monitoring-kube-prometheus-prometheus
    sidecarsNamespace: monitoring

service:
  type: NodePort
  ports:
    http: 9090
  nodePorts:
    http: 30900
