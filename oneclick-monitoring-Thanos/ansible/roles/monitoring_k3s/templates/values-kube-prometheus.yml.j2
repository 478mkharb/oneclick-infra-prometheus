# =========================================================
# GRAFANA (UI only, data comes from Thanos Query)
# =========================================================
grafana:
  enabled: true

  adminUser: admin
  adminPassword: admin

  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000

  defaultDashboardsEnabled: true

  sidecar:
    datasources:
      enabled: true
      defaultDatasourceEnabled: true
    
# =========================================================
# PROMETHEUS (PRIMARY TOOL, HA)
# =========================================================
prometheus:
  enabled: true

  # Never expose Prometheus directly
  service:
    type: ClusterIP

  # REQUIRED so Thanos Query can discover sidecars
  thanosService:
    enabled: true

  prometheusSpec:
    replicas: 2
    # ⏱ control upload frequency to Thanos (and thus query freshness)
    minBlockDuration: 2m
    maxBlockDuration: 2m
    retention: 1d

    resources:
      requests:
        cpu: 250m
        memory: 512Mi
      limits:
        cpu: 500m
        memory: 1Gi

    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi

    # Thanos Sidecar (uploads blocks, serves gRPC)
    thanos:
      objectStorageConfig:
        existingSecret:
          name: thanos-objstore
          key: objstore.yml


# =========================================================
# THANOS QUERY (UI + API)
# =========================================================
thanosQuery:
  enabled: true
  replicaCount: 1

  # Discover Prometheus sidecars + Store Gateway
  stores:
    - monitoring-kube-prometheus-thanos-discovery.monitoring.svc.cluster.local:10901

  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      cpu: "1"
      memory: 2Gi


# =========================================================
# THANOS QUERY FRONTEND (EXPOSED VIA ALB)
# =========================================================
thanosQueryFrontend:
  enabled: true

  service:
    type: NodePort
    port: 9090
    targetPort: 9090
    nodePort: 30900


# =========================================================
# THANOS STORE GATEWAY (READS FROM S3)
# =========================================================
thanosStoreGateway:
  enabled: true
  replicaCount: 1

  objectStorageConfig:
    existingSecret:
      name: thanos-objstore
      key: objstore.yml

  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: 500m
      memory: 1Gi


# =========================================================
# THANOS COMPACTOR (WRITES TO S3)
# =========================================================
thanosCompactor:
  enabled: true

  retentionResolutionRaw: 30d
  retentionResolution5m: 90d
  retentionResolution1h: 1y

  objectStorageConfig:
    existingSecret:
      name: thanos-objstore
      key: objstore.yml

  persistence:
    enabled: true
    size: 20Gi

  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: 500m
      memory: 1Gi


# =========================================================
# NODE EXPORTER
# =========================================================
prometheus-node-exporter:
  enabled: true
  tolerations:
    - operator: Exists


# =========================================================
# KUBE STATE METRICS
# =========================================================
kube-state-metrics:
  enabled: true


# =========================================================
# ALERTMANAGER (DISABLED)
# =========================================================
alertmanager:
  enabled: false
