# =========================================================
# GRAFANA (UI only, data from Thanos)
# =========================================================
grafana:
  enabled: true

  adminUser: admin
  adminPassword: admin

  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000

  defaultDashboardsEnabled: true

  sidecar:
    datasources:
      enabled: true
      defaultDatasourceEnabled: true
  
  datasources: {}

# =========================================================
# PROMETHEUS (PRIMARY TOOL, HA)
# =========================================================
prometheus:
  enabled: true

  service:
    type: ClusterIP   # never expose Prometheus directly

  # REQUIRED for Thanos discovery
  thanosService:
    enabled: true

  prometheusSpec:
    replicas: 2
    retention: 10d

    resources:
      requests:
        memory: 512Mi
        cpu: 250m
      limits:
        memory: 1Gi
        cpu: 500m

    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi

    # Thanos Sidecar
    thanos:
      objectStorageConfig:
        existingSecret:
          name: thanos-objstore
          key: objstore.yml


# =========================================================
# THANOS QUERY (HA PROMETHEUS UI)
# =========================================================
thanosQuery:
  enabled: true
  replicaCount: 1

  # IMPORTANT: static store discovery
  stores:
    - monitoring-kube-prometheus-thanos-discovery.monitoring.svc.cluster.local:10901

  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      cpu: "1"
      memory: 2Gi


thanosQueryFrontend:
  enabled: true

  service:
    type: NodePort
    port: 9090
    targetPort: 9090
    nodePort: 30900


# =========================================================
# NODE EXPORTER
# =========================================================
prometheus-node-exporter:
  enabled: true
  tolerations:
    - operator: Exists


# =========================================================
# KUBE STATE METRICS
# =========================================================
kube-state-metrics:
  enabled: true


# =========================================================
# ALERTMANAGER (DISABLED)
# =========================================================
alertmanager:
  enabled: false
